<Defs>


    <!-- Salted Meat -->
    <ThingDef ParentName="OrganicProductBase">
        <defName>SM_SaltedMeat</defName>
        <label>salted meat</label>
        <description>Meat preserved with salt. Salt absorbs water and kills bacteria, preventing it from rotting.</description>
        <graphicData>	
			<texPath>Things/Items/SM_SaltedMeat</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
        <socialPropernessMatters>true</socialPropernessMatters>
        <thingCategories>
            <li>MeatRaw</li>
        </thingCategories>
        <statBases>
            <MarketValue>2.6</MarketValue>
            <Mass>0.05</Mass>
            <MaxHitPoints>60</MaxHitPoints>
            <Flammability>0.5</Flammability>
            <Nutrition>0.125</Nutrition>
            <FoodPoisonChanceFixedHuman>0.001</FoodPoisonChanceFixedHuman>
        </statBases>
        <ingestible>
			<foodType>Meat</foodType>
			<preferability>MealFine</preferability>
			<ingestEffect>EatMeat</ingestEffect>
			<ingestSound>Meat_Eat</ingestSound>
            <canAutoSelectAsFoodForCaravan>true</canAutoSelectAsFoodForCaravan>
		</ingestible>
    </ThingDef>

