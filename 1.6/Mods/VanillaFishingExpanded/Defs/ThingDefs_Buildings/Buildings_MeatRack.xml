<Defs>

    <ThingDef ParentName="BuildingBase">
        <defName>SM_FishRack</defName>
        <label>fish rack</label>
        <description>A wooden rack where fish are left to dry with ambient heat.</description>
        <inspectorTabs>
            <li>PipeSystem.ITab_Processor</li>
        </inspectorTabs>
        <drawerType>MapMeshAndRealTime</drawerType>
        <graphicData>
            <texPath>Things/Buildings/SM_FishRack/SM_FishRack_empty</texPath>
            <graphicClass>Graphic_Multi</graphicClass>
            <drawSize>(1.5,1.5)</drawSize>
            <damageData>
                <cornerTL>Damage/Corner</cornerTL>
                <cornerTR>Damage/Corner</cornerTR>
                <cornerBL>Damage/Corner</cornerBL>
                <cornerBR>Damage/Corner</cornerBR>
            </damageData>
        </graphicData>
        <tickerType>Rare</tickerType>
        <costList>
            <WoodLog>20</WoodLog>
            <Cloth>10</Cloth>
        </costList>
        <altitudeLayer>Building</altitudeLayer>
        <rotatable>false</rotatable>
        <neverMultiSelect>true</neverMultiSelect>
        <uiIconScale>0.8</uiIconScale>
        <fillPercent>0.5</fillPercent>
        <useHitPoints>True</useHitPoints>
        <statBases>
            <Mass>10</Mass>
            <WorkToBuild>450</WorkToBuild>
            <MaxHitPoints>100</MaxHitPoints>
            <Flammability>1.0</Flammability>
        </statBases>
        <thingCategories>
            <li>BuildingsProduction</li>
        </thingCategories>
        <building>
            <ai_chillDestination>false</ai_chillDestination>
            <artificialForMeditationPurposes>false</artificialForMeditationPurposes>
            <buildingTags>
                <li>Production</li>
            </buildingTags>
        </building>
        <size>(1,1)</size>
        <designationCategory>Production</designationCategory>
        <passability>PassThroughOnly</passability>
        <pathCost>70</pathCost>
        <surfaceType>Item</surfaceType>
        <comps>
            <li Class="PipeSystem.CompProperties_AdvancedResourceProcessor">
                <notWorkingKey>SM_FishDryingRackNotWorking</notWorkingKey>
                <processes>
                    <li>SM_FishToDriedFish</li>
                </processes>
                <progressBarOffset>(0,0,-0.5)</progressBarOffset>
                <hideSettings>true</hideSettings>
                <inProgressTexture>Things/Buildings/SM_FishRack/SM_FishRack_full</inProgressTexture>
                <finishedTexture>Things/Buildings/SM_FishRack/SM_FishRack_finished</finishedTexture>
            </li>
        </comps>
        <minifiedDef>MinifiedThing</minifiedDef>
        <researchPrerequisites>
            <li>SM_SaltingTechniques</li>
        </researchPrerequisites>
        <placeWorkers>
            <li>PlaceWorker_PreventInteractionSpotOverlap</li>
        </placeWorkers>
    </ThingDef>

</Defs>